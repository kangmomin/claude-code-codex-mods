+test('런처가 분리된 Claude 자식에게 터미널 크기 변경 신호를 전달한다', {
+  skip: process.platform === 'win32',
+}, async (t) => {
+  const cwd = await mkdtemp(path.join(os.tmpdir(), 'launcher-resize-'));
+  t.after(() => removeTemporary(cwd));
+  await mkdir(path.join(cwd, 'bin'));
+  await writeFile(
+    path.join(cwd, 'bin', 'claude'),
+    `#!/usr/bin/env node
+const args=process.argv.slice(2);
+if(args.includes('plugin')&&args.includes('list')){console.log('not json');process.exit(1)}
+if(args[0]==='--version'){console.log('2.1.287');process.exit(0)}
+if(args[0]==='auth'){console.log(JSON.stringify({loggedIn:true}));process.exit(0)}
+process.on('SIGWINCH',()=>{console.log('resized');process.exit(7)});
+console.log('ready');
+setTimeout(()=>process.exit(9),5000);
+`,
+    { mode: 0o755 },
+  );
+  const launcher = fileURLToPath(
+    new URL('../../plugins/multi-core/src/launcher.ts', import.meta.url),
+  );
+  const result = await new Promise<{ code: number; stdout: string }>((resolve) => {
+    const child = execFile(
+      process.execPath,
+      [launcher],
+      {
+        cwd,
+        timeout: 20000,
+        env: {
+          PATH: path.join(cwd, 'bin') + path.delimiter + process.env.PATH,
+          HOME: cwd,
+          CLAUDE_CONFIG_DIR: path.join(cwd, 'claude'),
+          CODEX_HOME: cwd,
+          MULTI_ENABLED_PROVIDERS: '',
+        },
+      },
+      (error, stdout) => {
+        resolve({ code: typeof error?.code === 'number' ? error.code : 0, stdout });
+      },
+    );
+    child.stdout?.on('data', (chunk) => {
+      if (String(chunk).includes('ready')) {
+        child.kill('SIGWINCH');
+      }
+    });
+  });
+  assert.equal(result.code, 7);
+  assert.match(result.stdout, /resized/);
+});
